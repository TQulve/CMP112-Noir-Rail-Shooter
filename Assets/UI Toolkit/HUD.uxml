<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/USS/HUD.uss?fileID=7433441132597879392&amp;guid=5de73f93bf0dcac4f8efe6f55c5929fd&amp;type=3#HUD"/>
    <ui:VisualElement style="flex-grow: 1; justify-content: space-between; align-items: center; top: auto; flex-direction: column-reverse; align-self: auto; align-content: flex-end;">
        <ui:VisualElement name="VisualElement" style="flex-grow: 0; width: 100%; height: 50%; flex-direction: row; bottom: 0%;">
            <ui:VisualElement name="Focus" style="flex-grow: 1; align-items: flex-start; flex-direction: column-reverse;">
                <ui:Slider label="" value="42" high-value="100" data-source="project://database/Assets/Scripts/Player_Focus.asset?fileID=11400000&amp;guid=a44248f7da5aaac4886a5672935e22e0&amp;type=2#Player_Focus" style="width: 40%; height: 30%; left: 10%;">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="health" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Slider>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Image name="Crosshair" source="project://database/Assets/Images/Crosshair.png?fileID=2800000&amp;guid=d855e5feeb05efa48b209dce742576d5&amp;type=3#Crosshair" scale-mode="ScaleToFit" uv="0,0,1,1" style="position: absolute; top: 45%; width: 10%; height: 10%; left: 45.225%;"/>
    </ui:VisualElement>
</ui:UXML>
